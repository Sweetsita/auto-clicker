local function crearBoton(nombre, texto, tamano, posicion, padre)
	local boton = Instance.new("TextButton")
	boton.Name = nombre
	boton.Size = tamano
	boton.Position = posicion
	boton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	boton.BackgroundTransparency = 0.15
	boton.Text = texto
	boton.TextSize = 14
	boton.Font = Enum.Font.GothamBold
	boton.TextColor3 = Color3.new(1, 1, 1)
	boton.AutoButtonColor = false
	boton.Parent = padre or screenGui

	Instance.new("UICorner", boton).CornerRadius = UDim.new(0, 8)

	return boton
end

local function crearTexto(nombre, texto, posicion, tamano, padre)
