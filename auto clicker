local function disableNativeControls()
	pcall(function()
		local playerModule = require(
			player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
		)
		playerModule:GetControls():Disable()
	end)
end

local function enableNativeControls()
	pcall(function()
		local playerModule = require(
			player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
		)
		playerModule:GetControls():Enable()
	end)
end

