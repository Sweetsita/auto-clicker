-- =====================================
-- EJECUTAR UN CLIC
-- =====================================

local function obtenerPosicion()
	if posicionModo == "Elegida" and posicionElegida then
		return posicionElegida
	end

	local vs = camera.ViewportSize
	return Vector2.new(vs.X / 2, vs.Y / 2)
end

local function ejecutarOperacion()
    local punto = obtenerPosicion()
    local boton = botonesClick[botonIndex].value

    -- tipoIndex: 1 = Simple, 2 = Doble,
    -- 3 = Triple, 4 = Cuádruple
    local cantidad = tipoIndex

    local exito = pcall(function()
        virtualInput:SendMousePosition(punto)

        for i = 1, cantidad do
            virtualInput:SendMouseButton(
                punto,
                boton,
                true,
                0
            )

            virtualInput:SendMouseButton(
                punto,
                boton,
                false,
                0
            )

            if i < cantidad then
                task.wait(0.001)
            end
        end
    end)

    return exito
end

local function detenerAutoClicker()
	autoEnabled = false
	tiempoAcumulado = 0
	autoBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
	statusLabel.Text = "Autoclicker: apagado"
end

-- =====================================
-- MOTOR DEL AUTOCLICKER
-- =====================================

RunService.Heartbeat:Connect(function(dt)
	if not autoEnabled or not systemActive then
		tiempoAcumulado = 0
		return
	end

	tiempoAcumulado += dt

	local intervaloSegundos = intervaloClick / 1000

	if tiempoAcumulado < intervaloSegundos then
		return
	end

	-- Evitar recuperar retrasos con ráfagas enormes
	local pendientes = math.floor(tiempoAcumulado / intervaloSegundos)
	pendientes = math.min(pendientes, 8)

	for i = 1, pendientes do
		if not autoEnabled then
			break
		end

		if not ejecutarOperacion() then
			detenerAutoClicker()
			break
		end

		tiempoAcumulado -= intervaloSegundos
		cantidadRealizada += 1

		if not repetirContinuamente
		and cantidadRealizada >= cantidadRepeticiones then
			detenerAutoClicker()
			break
		end
	end

	tiempoAcumulado = math.max(tiempoAcumulado, 0)
end)

-- =====================================
-- ACTIVAR / DESACTIVAR AUTOCLICKER
-- =====================================

local autoTouch = nil
local autoStartPos = nil
local dragStartPos = nil
local buttonStartPos = nil
local autoDragging = false

autoBtn.InputBegan:Connect(function(input)
	if (
		input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
	) and not autoTouch then
		autoTouch = input
		autoStartPos = input.Position
		dragStartPos = input.Position
		buttonStartPos = autoBtn.Position
		autoDragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == autoTouch then
		local delta = input.Position - autoStartPos

		if delta.Magnitude > 15 then
			autoDragging = true
		end

		if autoDragging then
			local dx = input.Position.X - dragStartPos.X
			local dy = input.Position.Y - dragStartPos.Y

			autoBtn.Position = UDim2.new(
				buttonStartPos.X.Scale,
				buttonStartPos.X.Offset + dx,
				buttonStartPos.Y.Scale,
				buttonStartPos.Y.Offset + dy
			)

			speedBtn.Position = UDim2.new(
				autoBtn.Position.X.Scale,
				autoBtn.Position.X.Offset,
				autoBtn.Position.Y.Scale,
				autoBtn.Position.Y.Offset + 75
			)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == autoTouch then
		if not autoDragging then
			if autoEnabled then
				detenerAutoClicker()
			else
				autoEnabled = true
				cantidadRealizada = 0
				tiempoAcumulado = 0
				autoBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
				statusLabel.Text = "Autoclicker: encendido"
			end
		end

		autoTouch = nil
		autoStartPos = nil
		dragStartPos = nil
		buttonStartPos = nil
		autoDragging = false
	end
end)

