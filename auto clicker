local function actualizarPanel()
	intervalLabel.Text = tostring(intervaloClick) .. " ms"
	speedBtn.Text = "⚡ " .. tostring(intervaloClick)

	typeBtn.Text = tiposClick[tipoIndex]
	mouseBtn.Text = botonesClick[botonIndex].name

	if repetirContinuamente then
		repeatBtn.Text = "Continua"
	else
		repeatBtn.Text = "Limitada"
	end

	countLabel.Text = tostring(cantidadRepeticiones) .. " veces"

	if posicionModo == "Centro" then
		positionBtn.Text = "Centro"
	else
		positionBtn.Text = "Elegida"
	end
end

local function cambiarIntervalo(delta)
	intervaloClick = math.clamp(intervaloClick + delta, 1, 60000)
	actualizarPanel()
end

intervalMinus.Activated:Connect(function()
	cambiarIntervalo(50)
end)

intervalPlus.Activated:Connect(function()
	cambiarIntervalo(-50)
end)

-- El botón ⚡ cambia entre intervalos preestablecidos
