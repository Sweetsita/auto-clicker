UserInputService.InputBegan:Connect(function(input, procesado)
	if not esperandoPosicion then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Touch
	and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end

	local objetos = player.PlayerGui:GetGuiObjectsAtPosition(
		input.Position.X,
		input.Position.Y
	)

	for _, objeto in ipairs(objetos) do
		if objeto:IsDescendantOf(screenGui) then
			return
		end
	end

	posicionElegida = Vector2.new(
		input.Position.X,
		input.Position.Y
	)

	posicionModo = "Elegida"
	esperandoPosicion = false
	pickBtn.Text = "Elegir"
	statusLabel.Visible = false
	actualizarPanel()
end)

