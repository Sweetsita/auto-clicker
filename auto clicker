-- =====================================
-- JOYSTICK
-- =====================================

local joyTouch = nil
local joyActive = false
local joyTargetOffset = Vector2.zero
local maxRadius = 41

joyBase.InputBegan:Connect(function(input)
	if (
		input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
	) and not joyTouch then
		joyTouch = input
		joyActive = true
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == joyTouch and joyActive then
		local center = joyBase.AbsolutePosition + joyBase.AbsoluteSize / 2
		local inputPos = Vector2.new(input.Position.X, input.Position.Y)
		local offset = inputPos - center

		if offset.Magnitude > maxRadius then
			offset = offset.Unit * maxRadius
		end

		joyTargetOffset = offset

		joyKnob.Position = UDim2.new(
			0.5, offset.X - 29,
			0.5, offset.Y - 29
		)
	end
end)

local function releaseJoystick()
	joyTouch = nil
	joyActive = false
	joyTargetOffset = Vector2.zero
	joyKnob.Position = UDim2.new(0.5, -29, 0.5, -29)

	if humanoid then
		humanoid:Move(Vector3.zero, false)
	end

	if hrp then
		local velocity = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
	end
end

UserInputService.InputEnded:Connect(function(input)
	if input == joyTouch then
		releaseJoystick()
	end
end)

-- =====================================
-- MOVIMIENTO SEGÚN LA CÁMARA
-- =====================================

RunService.RenderStepped:Connect(function()
	if not systemActive or not joyActive or not humanoid or not hrp then
		return
	end

	if humanoid.Health <= 0 then
		releaseJoystick()
		return
	end

	local dirX = joyTargetOffset.X / maxRadius
	local dirY = joyTargetOffset.Y / maxRadius

	local look = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector

	local forward = Vector3.new(look.X, 0, look.Z)
	local rightFlat = Vector3.new(right.X, 0, right.Z)

	if forward.Magnitude > 0.01 then
		forward = forward.Unit
	end

	if rightFlat.Magnitude > 0.01 then
		rightFlat = rightFlat.Unit
	end

	local moveDirection = forward * -dirY + rightFlat * dirX

	if moveDirection.Magnitude > 0.01 then
		humanoid:Move(moveDirection.Unit, false)
	else
		humanoid:Move(Vector3.zero, false)
	end
end)

actualizarPanel()